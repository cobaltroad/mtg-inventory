# Discord OAuth Configuration
# These MUST be set in your production environment
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
APP_DOMAIN=https://cobaltroad.com/projects/mtg

# Callback URL to add in Discord Developer Portal:
# https://cobaltroad.com/projects/mtg/api/auth/discord/callback

# Database (configure for your setup)
DATABASE_URL=postgres://user:password@localhost/mtg_inventory_production

# Rails
RAILS_ENV=production
SECRET_KEY_BASE=your_secret_key_base_here
